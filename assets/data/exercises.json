---
layout: null
---
[
  {% for exercise in site.exercises %}
    {
      "id": {{ exercise.slug | default: exercise.title | slugify | jsonify }},
      "name": {{ exercise.title | strip_html | jsonify }},
      "url": {{ exercise.url | relative_url | jsonify }},
      "category": {% if exercise.categories %}{{ exercise.categories | jsonify }}{% elsif exercise.category %}{{ exercise.category | jsonify }}{% else %}[]{% endif %},
      "featured": {% if exercise.tags contains "featured" %}true{% else %}false{% endif %},
      "equipment": {% if exercise.equipment %}{{ exercise.equipment | jsonify }}{% else %}[]{% endif %},
      "primaryMuscles": {% if exercise.muscle_group %}{{ exercise.muscle_group | jsonify }}{% else %}[]{% endif %},
      "secondaryMuscles": {% if exercise.secondary_muscles %}{{ exercise.secondary_muscles | jsonify }}{% else %}[]{% endif %},
      "images": [
        {% if exercise.gymvisual_id %}
          {{ "/assets/images/gymvisual/" | append: exercise.gymvisual_id | append: ".gif" | relative_url | jsonify }}
        {% elsif exercise.gallery and exercise.gallery.size > 0 %}
          {% for img in exercise.gallery %}
            {% assign img_path = img.image_path | default: img.url %}
            {% if img_path contains "://" %}
              {{ img_path | jsonify }}
            {% else %}
              {{ img_path | relative_url | jsonify }}
            {% endif %}{% unless forloop.last %},{% endunless %}
          {% endfor %}
        {% elsif exercise.header.teaser %}
          {{ exercise.header.teaser | relative_url | jsonify }}
        {% elsif exercise.teaser %}
          {{ exercise.teaser | relative_url | jsonify }}
        {% endif %}
      ]
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]