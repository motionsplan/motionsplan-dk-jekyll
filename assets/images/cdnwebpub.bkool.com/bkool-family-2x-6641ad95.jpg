288\":525,\"_271\":281,\"_203\":526,\"_239\":-5,\"_291\":527,\"_268\":312,\"_269\":528,\"_295\":529},{\"_285\":286,\"_46\":531,\"_288\":532,\"_271\":281,\"_203\":533,\"_239\":-5,\"_291\":534,\"_268\":320,\"_269\":535,\"_295\":536},[544,563,581,599,612],{\"_436\":545,\"_40\":561,\"_448\":562,\"_46\":-5},{\"_203\":546,\"_46\":547,\"_268\":401,\"_269\":401,\"_270\":-5,\"_271\":281,\"_273\":548},\"Workout - FTP on the Move 3.png\",\"https://cdn.rouvy.com/cms/Workout_FTP_on_the_Move_3_1905ffb5fd/Workout_FTP_on_the_Move_3_1905ffb5fd.png\",{\"_297\":549,\"_275\":555},{\"_285\":286,\"_46\":550,\"_288\":551,\"_271\":281,\"_203\":552,\"_239\":-5,\"_291\":553,\"_268\":303,\"_269\":303,\"_295\":554},\"https://cdn.rouvy.com/cms/small_Workout_FTP_on_the_Move_3_1905ffb5fd/small_Workout_FTP_on_the_Move_3_1905ffb5fd.png\",\"small_Workout_FTP_on_the_Move_3_1905ffb5fd\",\"small_Workout - FTP on the Move 3.png\",138.04,138039,{\"_285\":286,\"_46\":556,\"_288\":557,\"_271\":281,\"_203\":558,\"_239\":-5,\"_291\":559,\"_268\":359,\"_269\":359,\"_295\":560},\"https://cdn.rouvy.com/cms/thumbnail_Workout_FTP_on_the_Move_3_1905ffb5fd/thumbnail_Workout_FTP_on_the_Move_3_1905ffb5fd.png\",\"thumbnail_Workout_FTP_on_the_Move_3_1905ffb5fd\",\"thumbnail_Workout - FTP on the Move 3.png\",20.11,20107,\"FTP on the Move 3\",\"Workout\",{\"_436\":564,\"_40\":580,\"_448\":562,\"_46\":-5},{\"_203\":565,\"_46\":566,\"_268\":401,\"_269\":401,\"_270\":-5,\"_271\":281,\"_273\":567},\"Workout - Mads Pedersen's favourite.png\",\"https://cdn.rouvy.com/cms/Workout_Mads_Pedersen_s_favourite_6ec26c4b7b/Workout_Mads_Pedersen_s_favourite_6ec26c4b7b.png\",{\"_297\":568,\"_275\":574},{\"_285\":286,\"_46\":569,\"_288\":570,\"_271\":281,\"_203\":571,\"_239\":-5,\"_291\":572,\"_268\":303,\"_269\":303,\"_295\":573},\"https://cdn.rouvy.com/cms/small_Workout_Mads_Pedersen_s_favourite_6ec26c4b7b/small_Workout_Mads_Pedersen_s_favourite_6ec26c4b7b.png\",\"small_Workout_Mads_Pedersen_s_favourite_6ec26c4b7b\",\"small_Workout - Mads Pedersen's favourite.png\",123,122996,{\"_285\":286,\"_46\":575,\"_288\":576,\"_271\":281,\"_203\":577,\"_239\":-5,\"_291\":578,\"_268\":359,\"_269\":359,\"_295\":579},\"https://cdn.rouvy.com/cms/thumbnail_Workout_Mads_Pedersen_s_favourite_6ec26c4b7b/thumbnail_Workout_Mads_Pedersen_s_favourite_6ec26c4b7b.png\",\"thumbnail_Workout_Mads_Pedersen_s_favourite_6ec26c4b7b\",\"thumbnail_Workout - Mads Pedersen's favourite.png\",14.88,14879,\"Mads Pedersen's favourite\",{\"_436\":582,\"_40\":598,\"_448\":562,\"_46\":-5},{\"_203\":583,\"_46\":584,\"_268\":401,\"_269\":401,\"_270\":-5,\"_271\":281,\"_273\":585},\"Workout - Wout van Aert's favourite.png\",\"https://cdn.rouvy.com/cms/Workout_Wout_van_Aert_s_favourite_8cab135a11/Workout_Wout_van_Aert_s_favourite_8cab135a11.png\",{\"_297\":586,\"_275\":592},{\"_285\":286,\"_46\":587,\"_288\":588,\"_271\":281,\"_203\":589,\"_239\":-5,\"_291\":590,\"_268\":303,\"_269\":303,\"_295\":591},\"https://cdn.rouvy.com/cms/small_Workout_Wout_van_Aert_s_favourite_8cab135a11/small_Workout_Wout_van_Aert_s_favourite_8cab135a11.png\",\"small_Workout_Wout_van_Aert_s_favourite_8cab135a11\",\"small_Workout - Wout van Aert's favourite.png\",111.85,111850,{\"_285\":286,\"_46\":593,\"_288\":594,\"_271\":281,\"_203\":595,\"_239\":-5,\"_291\":596,\"_268\":359,\"_269\":359,\"_295\":597},\"https://cdn.rouvy.com/cms/thumbnail_Workout_Wout_van_Aert_s_favourite_8cab135a11/thumbnail_Workout_Wout_van_Aert_s_favourite_8cab135a11.png\",\"thumbnail_Workout_Wout_van_Aert_s_favourite_8cab135a11\",\"thumbnail_Workout - Wout van Aert's favourite.png\",14.65,14646,\"Wout van Aert's favourite\",{\"_436\":600,\"_40\":610,\"_448\":611,\"_46\":-5},{\"_203\":601,\"_46\":602,\"_268\":454,\"_269\":454,\"_270\":-5,\"_271\":281,\"_273\":603},\"triathlon workout coll.png\",\"https://cdn.rouvy.com/cms/triathlon_workout_coll_39d6897171/triathlon_workout_coll_39d6897171.png\",{\"_275\":604},{\"_285\":286,\"_46\":605,\"_288\":606,\"_271\":281,\"_203\":607,\"_239\":-5,\"_291\":608,\"_268\":359,\"_269\":359,\"_295\":609},\"https://cdn.rouvy.com/cms/thumbnail_triathlon_workout_coll_39d6897171/thumbnail_triathlon_workout_coll_39d6897171.png\",\"thumbnail_triathlon_workout_coll_39d6897171\",\"thumbnail_triathlon workout coll.png\",40.66,40660,\"Block 1: Half-Distance Triathlon\",\"Training plan\",{\"_436\":613,\"_40\":623,\"_448\":497,\"_46\":-5},{\"_203\":614,\"_46\":615,\"_268\":440,\"_269\":440,\"_270\":-5,\"_271\":281,\"_273\":616},\"card workouts.png\",\"https://cdn.rouvy.com/cms/card_workouts_8f813772c0/card_workouts_8f813772c0.png\",{\"_275\":617},{\"_285\":286,\"_46\":618,\"_288\":619,\"_271\":281,\"_203\":620,\"_239\":-5,\"_291\":621,\"_268\":359,\"_269\":359,\"_295\":622},\"https://cdn.rouvy.com/cms/thumbnail_card_workouts_8f813772c0/thumbnail_card_workouts_8f813772c0.png\",\"thumbnail_card_workouts_8f813772c0\",\"thumbnail_card workouts.png\",38.23,38226,\"600+ workouts\",{\"_250\":625,\"_365\":626,\"_627\":-5,\"_628\":-5,\"_629\":-5,\"_630\":631},\"ComponentSharedHighlights\",\"17474\",\"highlightsAnchor\",\"highlightsTitle\",\"Layout\",\"Highlight\",[632],{\"_633\":634,\"_635\":636,\"_637\":638,\"_665\":-5,\"_666\":-5,\"_667\":668},\"contentTitle\",\"ROUVY’S ALWAYS ADDING NEW FITNESS APP INTEGRATIONS\",\"contentText\",\"You can seamlessly integrate ROUVY and the leading fitness-tracking platforms, allowing you to track your outdoor and indoor efforts in one place, and import customized workouts. ROUVY syncs with Strava, GARMIN Connect, TrainingPeaks, TriDot and many others.\",\"contentImage\",{\"_203\":639,\"_46\":640,\"_268\":641,\"_269\":642,\"_270\":-5,\"_271\":281,\"_273\":643},\"new integrations HP.png\",\"https://cdn.rouvy.com/cms/new_integrations_HP_1bb923e065/new_integrations_HP_1bb923e065.png\",752,560,{\"_297\":644,\"_306\":651,\"_275\":658},{\"_285\":286,\"_46\":645,\"_288\":646,\"_271\":281,\"_203\":647,\"_239\":-5,\"_291\":648,\"_268\":303,\"_269\":649,\"_295\":650},\"https://cdn.rouvy.com/cms/small_new_integrations_HP_1bb923e065/small_new_integrations_HP_1bb923e065.png\",\"small_new_integrations_HP_1bb923e065\",\"small_new integrations HP.png\",116.32,372,116319,{\"_285\":286,\"_46\":652,\"_288\":653,\"_271\":281,\"_203\":654,\"_239\":-5,\"_291\":655,\"_268\":312,\"_269\":656,\"_295\":657},\"https://cdn.rouvy.com/cms/medium_new_integrations_HP_1bb923e065/medium_new_integrations_HP_1bb923e065.png\",\"medium_new_integrations_HP_1bb923e065\",\"medium_new integrations HP.png\",188.73,559,188726,{\"_285\":286,\"_46\":659,\"_288\":660,\"_271\":281,\"_203\":661,\"_239\":-5,\"_291\":662,\"_268\":663,\"_269\":359,\"_295\":664},\"https://cdn.rouvy.com/cms/thumbnail_new_integrations_HP_1bb923e065/thumbnail_new_integrations_HP_1bb923e065.png\",\"thumbnail_new_integrations_HP_1bb923e065\",\"thumbnail_new integrations HP.png\",33.27,209,33272,\"button\",\"buttonAlt\",\"transformedContentText\",[\"SingleFetchClassInstance\",669],{\"_670\":671,\"_203\":672,\"_673\":674,\"_675\":676},\"$$mdtype\",\"Tag\",\"article\",\"attributes\",{},\"children\",[677],[\"SingleFetchClassInstance\",678],{\"_670\":671,\"_203\":679,\"_673\":680,\"_675\":681},\"p\",{},[636],{\"_250\":683,\"_365\":684,\"_685\":686,\"_687\":-5,\"_688\":689,\"_665\":-5,\"_690\":691,\"_692\":693,\"_701\":702},\"ComponentSharedPlansSelector\",\"2182\",\"plansSelectorTitle\",\"Flexible plans and a 7-day free trial\",\"plansSelectorSubtitle\",\"plansSelectorAnchor\",\"pricing\",\"termsSection\",\"Choose from three monthly and three yearly plans to find the ideal option for your indoor cycling routine and budget. All ROUVY subscription plans begin with a free, 7-day trial, then are billed at the full monthly or yearly price.\",\"transformedTermsSection\",[\"SingleFetchClassInstance\",694],{\"_670\":671,\"_203\":672,\"_673\":695,\"_675\":696},{},[697],[\"SingleFetchClassInstance\",698],{\"_670\":671,\"_203\":679,\"_673\":699,\"_675\":700},{},[691],\"plansData\",{\"_703\":704},\"plans\",[705,718,723,728,732,735],{\"_365\":706,\"_707\":708,\"_40\":709,\"_710\":711,\"_712\":713,\"_714\":715,\"_716\":717},\"rouvy_single_eur_monthly\",\"item_id\",\"rouvy_single\",\"Single\",\"price\",1999,\"currency_code\",\"EUR\",\"period_unit\",\"month\",\"trial_period\",7,{\"_365\":719,\"_707\":720,\"_40\":721,\"_710\":722,\"_712\":713,\"_714\":715,\"_716\":717},\"rouvy_duo_eur_monthly\",\"rouvy_duo\",\"Duo\",2999,{\"_365\":724,\"_707\":725,\"_40\":726,\"_710\":727,\"_712\":713,\"_714\":715,\"_716\":717},\"rouvy_group_eur_monthly\",\"rouvy_group\",\"Group\",5999,{\"_365\":729,\"_707\":708,\"_40\":709,\"_710\":730,\"_712\":713,\"_714\":731,\"_716\":717},\"rouvy_single_eur_yearly\",17999,\"year\",{\"_365\":733,\"_707\":720,\"_40\":721,\"_710\":734,\"_712\":713,\"_714\":731,\"_716\":717},\"rouvy_duo_eur_yearly\",24999,{\"_365\":736,\"_707\":725,\"_40\":726,\"_710\":737,\"_712\":713,\"_714\":731,\"_716\":717},\"rouvy_group_eur_yearly\",49999,{\"_250\":625,\"_365\":739,\"_627\":-5,\"_628\":-5,\"_629\":-5,\"_630\":740},\"17475\",[741],{\"_633\":742,\"_635\":743,\"_637\":744,\"_665\":-5,\"_666\":-5,\"_667\":766},\"WHAT DOES THE ROUVY APP DO?\",\"ROUVY connects with your indoor trainer to let you see real video of the route you’re riding. The app, connected to your trainer, knows the gradient of this route and will adjust the resistance of your bike to match the gradient.\",{\"_203\":745,\"_46\":746,\"_268\":641,\"_269\":642,\"_270\":-5,\"_271\":281,\"_273\":747},\"new highlight CZ/EN HP.png\",\"https://cdn.rouvy.com/cms/EN_HP_5bbdb8ceb0/EN_HP_5bbdb8ceb0.png\",{\"_297\":748,\"_306\":754,\"_275\":760},{\"_285\":286,\"_46\":749,\"_288\":750,\"_271\":281,\"_203\":751,\"_239\":-5,\"_291\":752,\"_268\":303,\"_269\":649,\"_295\":753},\"https://cdn.rouvy.com/cms/small_EN_HP_5bbdb8ceb0/small_EN_HP_5bbdb8ceb0.png\",\"small_EN_HP_5bbdb8ceb0\",\"small_new highlight CZ/EN HP.png\",359.82,359818,{\"_285\":286,\"_46\":755,\"_288\":756,\"_271\":281,\"_203\":757,\"_239\":-5,\"_291\":758,\"_268\":312,\"_269\":656,\"_295\":759},\"https://cdn.rouvy.com/cms/medium_EN_HP_5bbdb8ceb0/medium_EN_HP_5bbdb8ceb0.png\",\"medium_EN_HP_5bbdb8ceb0\",\"medium_new highlight CZ/EN HP.png\",768.66,768660,{\"_285\":286,\"_46\":761,\"_288\":762,\"_271\":281,\"_203\":763,\"_239\":-5,\"_291\":764,\"_268\":663,\"_269\":359,\"_295\":765},\"https://cdn.rouvy.com/cms/thumbnail_EN_HP_5bbdb8ceb0/thumbnail_EN_HP_5bbdb8ceb0.png\",\"thumbnail_EN_HP_5bbdb8ceb0\",\"thumbnail_new highlight CZ/EN HP.png\",70.25,70249,[\"SingleFetchClassInstance\",767],{\"_670\":671,\"_203\":672,\"_673\":768,\"_675\":769},{},[770],[\"SingleFetchClassInstance\",771],{\"_670\":671,\"_203\":679,\"_673\":772,\"_675\":773},{},[743],{\"_250\":775,\"_365\":776,\"_777\":778,\"_779\":780,\"_781\":-5,\"_782\":783,\"_829\":-5,\"_830\":199},\"ComponentSharedSteps\",\"2898\",\"stepsAnchor\",\"start\",\"stepsTitle\",\"start riding in three easy steps\",\"alternativeTitle\",\"step\",[784,799,815],{\"_372\":785,\"_795\":-5,\"_40\":796,\"_448\":797,\"_213\":798},{\"_203\":786,\"_46\":787,\"_268\":788,\"_269\":788,\"_270\":-5,\"_271\":281,\"_273\":789},\"howto1.png\",\"https://cdn.rouvy.com/cms/howto1_ad1a2f3424/howto1_ad1a2f3424.png\",260,{\"_275\":790},{\"_285\":286,\"_46\":791,\"_288\":792,\"_271\":281,\"_203\":793,\"_239\":-5,\"_291\":794,\"_268\":359,\"_269\":359},\"https://cdn.rouvy.com/cms/thumbnail_howto1_ad1a2f3424/thumbnail_howto1_ad1a2f3424.png\",\"thumbnail_howto1_ad1a2f3424\",\"thumbnail_howto1.png\",11.91,\"alternativeImage\",\"Create an account and download the app\",\"The ROUVY app is available on PC, Mac, iPad, Android, iPhone, and Apple TV.\",[],{\"_372\":800,\"_795\":-5,\"_40\":812,\"_448\":813,\"_213\":814},{\"_203\":801,\"_46\":802,\"_268\":803,\"_269\":804,\"_270\":-5,\"_271\":281,\"_273\":805},\"howto step 2.png\",\"https://cdn.rouvy.com/cms/howto_step_2_d9d3a772c3/howto_step_2_d9d3a772c3.png\",242,263,{\"_275\":806},{\"_285\":286,\"_46\":807,\"_288\":808,\"_271\":281,\"_203\":809,\"_239\":-5,\"_291\":810,\"_268\":811,\"_269\":359},\"https://cdn.rouvy.com/cms/thumbnail_howto_step_2_d9d3a772c3/thumbnail_howto_step_2_d9d3a772c3.png\",\"thumbnail_howto_step_2_d9d3a772c3\",\"thumbnail_howto step 2.png\",21.64,144,\"Connect your trainer\",\"Your trainer will automatically connect when you first open the app.\",[],{\"_372\":816,\"_795\":-5,\"_40\":826,\"_448\":827,\"_213\":828},{\"_203\":817,\"_46\":818,\"_268\":788,\"_269\":788,\"_270\":-5,\"_271\":281,\"_273\":819},\"howto3_new2.png\",\"https://cdn.rouvy.com/cms/howto3_new2_6b031eca7e/howto3_new2_6b031eca7e.png\",{\"_275\":820},{\"_285\":286,\"_46\":821,\"_288\":822,\"_271\":281,\"_203\":823,\"_239\":-5,\"_291\":824,\"_268\":359,\"_269\":359,\"_295\":825},\"https://cdn.rouvy.com/cms/thumbnail_howto3_new2_6b031eca7e/thumbnail_howto3_new2_6b031eca7e.png\",\"thumbnail_howto3_new2_6b031eca7e\",\"thumbnail_howto3_new2.png\",44.08,44081,\"Start riding\",\"Imagine a place you've always wanted to explore on your bike and start your journey.\",[],\"stepsButton\",\"disableNumbering\",{\"_250\":832,\"_365\":833,\"_834\":835,\"_836\":837,\"_372\":-5,\"_838\":839,\"_840\":841,\"_361\":-5,\"_362\":-5},\"ComponentSharedRegisterCta\",\"2098\",\"registerCtaTitle\",\"Try ROUVY for free today\",\"registerCtaDescription\",\"Discover a completely new way to ride indoors by entering your email below.\",\"registerCtaAnchor\",\"register\",\"registerCtaCampaignId\",\"30\",{\"_250\":843,\"_365\":844,\"_845\":846,\"_847\":67,\"_848\":849,\"_876\":-5},\"ComponentSharedFaq\",\"5373\",\"faqAnchor\",\"faq\",\"faqTitle\",\"question\",[850,855,858,861,864,867,870,873],{\"_851\":852,\"_853\":854},\"questionText\",\"What is ROUVY and How Do I Use It?\",\"answer\",\"ROUVY is an indoor cycling app built around scenic routes filmed on location around the world, and realistic riding physics. Start by creating an account, downloading the ROUVY app, and syncing it with your indoor smart bike, direct-drive or classic trainer.\",{\"_851\":856,\"_853\":857},\"What Makes ROUVY One Of The Best Indoor Cycling Apps?\",\"ROUVY stands out for its thousands of ultra-realistic cycling routes, all filmed on location around the world for an authentic and immersive riding experience. Combined with tailored workouts and multi-week training plans designed by professional coaches and riders, ROUVY delivers structured, engaging training for cyclists of every level.\",{\"_851\":859,\"_853\":860},\"Which Platforms Does ROUVY Support?\",\"You can run the ROUVY app on Windows, Mac, iOS, Android, iPad, and Apple TV devices.\",{\"_851\":862,\"_853\":863},\"Does ROUVY Support Virtual Shifting?\",\"Yes! Riders with compatible hardware have the option to enable virtual shifting on ROUVY. This feature allows you to simulate changing gears on your smart trainer or bike without the need to manually shift gears. It brings your indoor training closer to the dynamics of outdoor cycling by mimicking the resistance changes that happen when shifting gears on the road.\",{\"_851\":865,\"_853\":866},\"What Fitness Apps Can I Sync With ROUVY?\",\"ROUVY offers deep integration with Strava, GARMIN Connect, TrainingPeaks and many others!\\n\\n\\n\\n\\n\",{\"_851\":868,\"_853\":869},\"What Equipment Do I Need To Get Started With ROUVY?\",\"All you need is a trainer and a bike (or a smart bike). ROUVY supports a wide range of brands including Zwift, TacX, Wahoo, Elite, Saris, Zycle and many others.\",{\"_851\":871,\"_853\":872},\"How Can I Access Routes, Races, And Training Plans On ROUVY? \",\"You can easily access the best routes, races, and training plans from the sidebar when you open the ROUVY app.\",{\"_851\":874,\"_853\":875},\"What Subscription Plans Does ROUVY Offer?\",\"ROUVY offers six subscription plans: monthly and annual options for solo users (SINGLE), you and a friend (DUO), or a group of up to five members (GROUP). After creating an account, you can invite friends or family to join your plan, allowing everyone to save by sharing a single subscription.\",\"faqButton\",\"contentLayers\",{\"_198\":228,\"_200\":199,\"_201\":879,\"_209\":-7,\"_210\":-7,\"_211\":881,\"_213\":896,\"_227\":228,\"_229\":199},{\"_203\":204,\"_40\":880,\"_206\":32,\"_207\":208},\"alt text\",[882,886,889,891,894],{\"_40\":883,\"_46\":884,\"_885\":-7},\"Routes\",\"https://rouvy.com#routes\",\"label\",{\"_40\":887,\"_46\":888,\"_885\":-7},\"Workouts\",\"https://rouvy.com#workouts\",{\"_40\":45,\"_46\":890,\"_885\":-7},\"https://rouvy.com#pricing\",{\"_40\":892,\"_46\":893,\"_885\":-7},\"How to start\",\"https://rouvy.com#start\",{\"_40\":67,\"_46\":895,\"_885\":-7},\"https://rouvy.com#faq\",[897],{\"_216\":898,\"_206\":899,\"_219\":226,\"_221\":222,\"_223\":-7},\"Sign in\",\"https://account.rouvy.com/sign-in\",\"metaProps\",{\"_902\":903,\"_945\":946,\"_952\":953},\"seo\",{\"_904\":905,\"_906\":907,\"_908\":-5,\"_909\":199,\"_910\":199,\"_911\":912},\"metaDescription\",\"Ride, race, and train on some of the most scenic routes from home. Works with all indoor trainers and devices.\",\"metaTitle\",\"The world's most realistic indoor cycling app\",\"ogTitle\",\"noFollow\",\"noIndex\",\"shareImage\",{\"_203\":913,\"_46\":914,\"_268\":915,\"_269\":916,\"_270\":-5,\"_271\":281,\"_273\":917},\"Share image - HP.png\",\"https://cdn.rouvy.com/cms/Share_image_HP_76512fb44f/Share_image_HP_76512fb44f.png\",1200,631,{\"_283\":918,\"_297\":925,\"_306\":931,\"_275\":938},{\"_285\":286,\"_46\":919,\"_288\":920,\"_271\":281,\"_203\":921,\"_239\":-5,\"_291\":922,\"_268\":293,\"_269\":923,\"_295\":924},\"https://cdn.rouvy.com/cms/large_Share_image_HP_76512fb44f/large_Share_image_HP_76512fb44f.png\",\"large_Share_image_HP_76512fb44f\",\"large_Share image - HP.png\",938.18,526,938179,{\"_285\":286,\"_46\":926,\"_288\":927,\"_271\":281,\"_203\":928,\"_239\":-5,\"_291\":929,\"_268\":303,\"_269\":804,\"_295\":930},\"https://cdn.rouvy.com/cms/small_Share_image_HP_76512fb44f/small_Share_image_HP_76512fb44f.png\",\"small_Share_image_HP_76512fb44f\",\"small_Share image - HP.png\",257.56,257562,{\"_285\":286,\"_46\":932,\"_288\":933,\"_271\":281,\"_203\":934,\"_239\":-5,\"_291\":935,\"_268\":312,\"_269\":936,\"_295\":937},\"https://cdn.rouvy.com/cms/medium_Share_image_HP_76512fb44f/medium_Share_image_HP_76512fb44f.png\",\"medium_Share_image_HP_76512fb44f\",\"medium_Share image - HP.png\",551.97,394,551972,{\"_285\":286,\"_46\":939,\"_288\":940,\"_271\":281,\"_203\":941,\"_239\":-5,\"_291\":942,\"_268\":320,\"_269\":943,\"_295\":944},\"https://cdn.rouvy.com/cms/thumbnail_Share_image_HP_76512fb44f/thumbnail_Share_image_HP_76512fb44f.png\",\"thumbnail_Share_image_HP_76512fb44f\",\"thumbnail_Share image - HP.png\",71.28,129,71283,\"pageState\",{\"_947\":948,\"_949\":-5,\"_5\":6,\"_239\":242,\"_950\":-7,\"_951\":12},\"status\",\"PUBLISHED\",\"variant\",\"canonical\",\"env\",\"localizations\",[954,955,956,957,958],\"es\",\"cs\",\"fr\",\"de\",\"it\",\"experiments\",[961],{\"_962\":963,\"_949\":222},\"experiment\",\"web-homepage-variant\",\"DynamicPageStructuredData\",\"actionData\",\"errors\"]\n");</script><!--$--><script>window.__reactRouterContext.streamController.close();</script><!--/$--><!--/$--></body></html>