]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-border-secondary-subtle py-8"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:R1d6j35:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:Rd6j35:" class="group flex flex-1 items-center justify-between gap-8 text-left text-body-16 leading-[150%] font-semibold text-text-default transition-all md:text-body-18 xl:text-body-20" data-radix-collection-item=""><div class="pr-4 md:pr-6">What Equipment Do I Need To Get Started With ROUVY?</div><div class="pr-4 md:pr-6"><svg class="inline self-center h-4 w-4 shrink-0 rotate-180 text-icon-inactive transition-transform duration-200 group-data-[state=open]:rotate-0"><use href="/assets/sprite-BHcpGKNd.svg#chevron-up"></use></svg></div></button></h3><div data-state="closed" id="radix-:R1d6j35:" hidden="" role="region" aria-labelledby="radix-:Rd6j35:" data-orientation="vertical" class="overflow-hidden text-body-20 leading-[150%] font-semibold text-text-muted data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-border-secondary-subtle py-8"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:R1f6j35:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:Rf6j35:" class="group flex flex-1 items-center justify-between gap-8 text-left text-body-16 leading-[150%] font-semibold text-text-default transition-all md:text-body-18 xl:text-body-20" data-radix-collection-item=""><div class="pr-4 md:pr-6">How Can I Access Routes, Races, And Training Plans On ROUVY? </div><div class="pr-4 md:pr-6"><svg class="inline self-center h-4 w-4 shrink-0 rotate-180 text-icon-inactive transition-transform duration-200 group-data-[state=open]:rotate-0"><use href="/assets/sprite-BHcpGKNd.svg#chevron-up"></use></svg></div></button></h3><div data-state="closed" id="radix-:R1f6j35:" hidden="" role="region" aria-labelledby="radix-:Rf6j35:" data-orientation="vertical" class="overflow-hidden text-body-20 leading-[150%] font-semibold text-text-muted data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-border-secondary-subtle py-8"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:R1h6j35:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:Rh6j35:" class="group flex flex-1 items-center justify-between gap-8 text-left text-body-16 leading-[150%] font-semibold text-text-default transition-all md:text-body-18 xl:text-body-20" data-radix-collection-item=""><div class="pr-4 md:pr-6">What Subscription Plans Does ROUVY Offer?</div><div class="pr-4 md:pr-6"><svg class="inline self-center h-4 w-4 shrink-0 rotate-180 text-icon-inactive transition-transform duration-200 group-data-[state=open]:rotate-0"><use href="/assets/sprite-BHcpGKNd.svg#chevron-up"></use></svg></div></button></h3><div data-state="closed" id="radix-:R1h6j35:" hidden="" role="region" aria-labelledby="radix-:Rh6j35:" data-orientation="vertical" class="overflow-hidden text-body-20 leading-[150%] font-semibold text-text-muted data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"></div></div></div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is ROUVY and How Do I Use It?","acceptedAnswer":{"@type":"Answer","text":"ROUVY is an indoor cycling app built around scenic routes filmed on location around the world, and realistic riding physics. Start by creating an account, downloading the ROUVY app, and syncing it with your indoor smart bike, direct-drive or classic trainer."}},{"@type":"Question","name":"What Makes ROUVY One Of The Best Indoor Cycling Apps?","acceptedAnswer":{"@type":"Answer","text":"ROUVY stands out for its thousands of ultra-realistic cycling routes, all filmed on location around the world for an authentic and immersive riding experience. Combined with tailored workouts and multi-week training plans designed by professional coaches and riders, ROUVY delivers structured, engaging training for cyclists of every level."}},{"@type":"Question","name":"Which Platforms Does ROUVY Support?","acceptedAnswer":{"@type":"Answer","text":"You can run the ROUVY app on Windows, Mac, iOS, Android, iPad, and Apple TV devices."}},{"@type":"Question","name":"Does ROUVY Support Virtual Shifting?","acceptedAnswer":{"@type":"Answer","text":"Yes! Riders with compatible hardware have the option to enable virtual shifting on ROUVY. This feature allows you to simulate changing gears on your smart trainer or bike without the need to manually shift gears. It brings your indoor training closer to the dynamics of outdoor cycling by mimicking the resistance changes that happen when shifting gears on the road."}},{"@type":"Question","name":"What Fitness Apps Can I Sync With ROUVY?","acceptedAnswer":{"@type":"Answer","text":"ROUVY offers deep integration with Strava, GARMIN Connect, TrainingPeaks and many others!\n\n\n\n\n"}},{"@type":"Question","name":"What Equipment Do I Need To Get Started With ROUVY?","acceptedAnswer":{"@type":"Answer","text":"All you need is a trainer and a bike (or a smart bike). ROUVY supports a wide range of brands including Zwift, TacX, Wahoo, Elite, Saris, Zycle and many others."}},{"@type":"Question","name":"How Can I Access Routes, Races, And Training Plans On ROUVY? ","acceptedAnswer":{"@type":"Answer","text":"You can easily access the best routes, races, and training plans from the sidebar when you open the ROUVY app."}},{"@type":"Question","name":"What Subscription Plans Does ROUVY Offer?","acceptedAnswer":{"@type":"Answer","text":"ROUVY offers six subscription plans: monthly and annual options for solo users (SINGLE), you and a friend (DUO), or a group of up to five members (GROUP). After creating an account, you can invite friends or family to join your plan, allowing everyone to save by sharing a single subscription."}}]}</script></div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Rouvy","url":"https://rouvy.com","logo":"https://rouvy.com/path/to/logo.png","contactPoint":[{"@type":"ContactPoint","telephone":"+420 910 920 986","contactType":"customer service","areaServed":"Global","availableLanguage":["English"]}],"email":"support@rouvy.com","sameAs":["https://www.facebook.com/rouvy","https://www.instagram.com/rouvy","https://www.twitter.com/rouvy","https://www.linkedin.com/company/rouvy"],"address":[{"@type":"PostalAddress","streetAddress":"Rustonka 2, Rohanské nábř. 693/10","addressLocality":"Praha 8-Karlín","postalCode":"186 00","addressCountry":"CZ"}]}</script></div><div class="border-t border-border-secondary-subtle"><div class="bg-background-canvas"><div class="container flex flex-col gap-12 py-10 md:py-12 lg:py-14"><div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-5"><div class="flex flex-col gap-4"><h5 class="text-body-16 leading-4 f