---
layout: null
---
[
{% assign all_pages = site.pages | concat: site.posts %}
  {% for page in all_pages %}
    {% if page.url contains '.html' or page.url contains '/' %}
    {
      "url": {{ page.url | jsonify }},
      "title": {{ page.title | jsonify }},
      "seo_title": {{ page.seo_title | default: page.title | jsonify }},
      "word_count": {{ page.content | number_of_words }},
      "excerpt": {{ page.excerpt | strip_html | strip_newlines | jsonify }},
      "description": {{ page.description | default: page.excerpt | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
{% endfor %}
]