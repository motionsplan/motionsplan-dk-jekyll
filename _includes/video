{% assign video_id = include.id %}
{% assign video_provider = include.provider %}

<div class="responsive-video-container">
{% if video_provider == "vimeo" %}
  <iframe src="https://player.vimeo.com/video/{{ video_id }}?dnt=true" allowfullscreen loading="lazy"></iframe>

{% elsif video_provider == "youtube" %}
  <div class="youtube-container">
    <div class="youtube-player" data-id="{{ video_id }}">
      <a href="https://www.youtube.com/watch?v={{ video_id }}" rel="nofollow noopener">
        <img class="youtube-thumb" src="https://i.ytimg.com/vi/{{ video_id }}/hqdefault.jpg" loading="lazy" alt="Video: {{ include.title | default: page.title | escape }}">
        <span class="play-button"></span>
      </a>
    </div>
  </div>

{% elsif video_provider == "google-drive" %}
  <iframe src="https://drive.google.com/file/d/{{ video_id }}/preview" allowfullscreen loading="lazy"></iframe>

{% elsif video_provider == "wistia-net" %}
  <iframe src="https://fast.wistia.net/embed/iframe/{{ video_id }}?videoFoam=true" name="wistia_embed" allowfullscreen loading="lazy"></iframe>

{% elsif video_provider == "facebook" %}
  <iframe src="https://www.facebook.com/plugins/video.php?href=https://www.facebook.com/{{ video_id }}&show_text=0&width=600" scrolling="no" allowfullscreen loading="lazy"></iframe>
{% endif %}
</div>