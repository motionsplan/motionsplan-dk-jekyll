{% if include.id %}
  {% assign gallery = page[include.id] %}
{% elsif include.images %}
  {% assign gallery = include.images %}
{% else %}
  {% assign gallery = gallery %}
{% endif %}

{% if include.layout %}
  {% assign gallery_layout = include.layout %}
{% else %}
  {% if gallery.size == 2 %}
    {% assign gallery_layout = 'half' %}
  {% elsif gallery.size >= 3 %}
    {% assign gallery_layout = 'third' %}
  {% else %}
    {% assign gallery_layout = '' %}
  {% endif %}
{% endif %}

{% if include.headline %}
<div class="section-with-lines">
  <div class="section-title-wrapper">
    <p class="section-title">
      <span>{{ include.headline }}</span>
    </p>
  </div>
{% endif %}

<figure class="{{ gallery_layout }} {{ include.class }}">
  {%- for img in gallery -%}
    {% assign raw_img = img.image_path | absolute_url %}

    {% if site.image_cdn != "" and site.image_cdn and jekyll.environment != "development" %}
      {% assign img_width = include.width | default: "500" %}
      {% assign img_width_2x = img_width | times: 2 %}
      
      {% assign img_src = site.image_cdn | append: "f_auto,q_auto:eco,w_" | append: img_width | append: "/" | append: raw_img %}
      {% assign img_src_2x = site.image_cdn | append: "f_auto,q_auto:eco,w_" | append: img_width_2x | append: "/" | append: raw_img %}
    {% else %}
      {% assign img_src = img.image_path | relative_url %}
    {% endif %}

    {%- if img.url -%}
      <a href="{{ img.url | relative_url }}"{%- if img.title %} title="{{ img.title }}"{%- endif -%}>
        <img src="{{ img_src }}"
             {% if site.image_cdn != "" and site.image_cdn and jekyll.environment != "development" %}
               srcset="{{ img_src }} {{ img_width }}w, {{ img_src_2x }} {{ img_width_2x }}w"
               sizes="(max-width: 768px) 100vw, {{ img_width }}px"
             {% endif %}
             alt="{% if img.alt %}{{ img.alt | escape }}{% endif %}"
             loading="lazy"
             decoding="async">
      </a>
    {%- else -%}
      <img src="{{ img_src }}"
           {% if site.image_cdn != "" and site.image_cdn and jekyll.environment != "development" %}
             srcset="{{ img_src }} {{ img_width }}w, {{ img_src_2x }} {{ img_width_2x }}w"
             sizes="(max-width: 768px) 100vw, {{ img_width }}px"
           {% endif %}
           alt="{% if img.alt %}{{ img.alt | escape }}{% endif %}"
           loading="lazy"
           decoding="async">
    {%- endif -%}
  {%- endfor -%}
  {% if include.caption %}
    <figcaption>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</figcaption>
  {% endif %}
</figure>

{% if include.headline %}
</div>
{% endif %}